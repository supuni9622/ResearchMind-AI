APP_NAME=ResearchMind AI
ENVIRONMENT=development
DEBUG=false

DATABASE_URL=

VALKEY_URL=

QDRANT_URL=
QDRANT_API_KEY=

SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=30

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="ResearchMind"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

AWS_REGION=

COGNITO_USER_POOL_ID=

COGNITO_APP_CLIENT_ID=

COGNITO_DOMAIN=

COGNITO_CLIENT_SECRET=

#######################################
# AI Core
#######################################

AI_AWS_REGION=us-east-1
AWS_S3_BUCKET=researchmind-ai-documents-dev

AWS_ACCESS_KEY_ID=

AWS_SECRET_ACCESS_KEY=

AWS_SESSION_TOKEN=

AWS_S3_ENDPOINT_URL=

QUEUE_NAME=document-processing
QUEUE_MAX_ATTEMPTS=3
SQS_QUEUE_URL=
QUEUE_PROVIDER=valkey

VOYAGE_API_KEY=
RETRIEVAL_RERANK_SCORE_THRESHOLD=0.2
OPENAI_API_KEY=
SEMANTIC_CACHE_EMBEDDING_PROVIDER=voyage_ai
SEMANTIC_CACHE_EMBEDDING_MODEL=voyage-3-lite
QDRANT_COLLECTION_NAME=researchmind_knowledge
SPARSE_EMBEDDING_MODEL=prithivida/Splade_PP_en_v1

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT_SECONDS=120

OPENAI_MODEL=gpt-5.5
CLAUDE_MODEL=claude-sonnet-5
GEMINI_MODEL=gemini-2.5-pro
GROQ_MODEL=openai/gpt-oss-120b
OLLAMA_MODEL=gemma4:12b

#######################################
# Web Search Tool (Research Runtime)
#######################################

# Web search stays inert (WEB_SEARCH_ENABLED=false, or no key here) without
# breaking Deep Research -- see web_search_tool_platform_prd.md.
TAVILY_API_KEY=
WEB_SEARCH_ENABLED=true

#######################################
# Research Intelligence MCP (paper search, Chat + Deep Research)
#######################################

# Paper search stays inert (MCP_PAPERS_ENABLED=false, or no server URL here)
# without breaking Chat or Deep Research -- see prds/3. mcp_server_setup.md.
MCP_PAPERS_ENABLED=true
MCP_PAPERS_SERVER_URL=http://127.0.0.1:8080/mcp
MCP_PAPERS_AUTH_TOKEN=
MCP_PAPERS_TIMEOUT_SECONDS=60
MCP_PAPERS_QUERY_PROVIDER=auto

#######################################
# Prometheus / Grafana Observability
#######################################

# PROMETHEUS_ENABLED=false is the rollback flag -- every metrics call site
# degrades to a NoOp recorder and /metrics is not mounted at all, so the
# rest of the app is unaffected. See prds/prometheus_grafana_observability_prd.md.
PROMETHEUS_ENABLED=true
PROMETHEUS_METRICS_PATH=/metrics
PROMETHEUS_INCLUDE_HTTP_METRICS=true
PROMETHEUS_INCLUDE_RUNTIME_METRICS=true
PROMETHEUS_INCLUDE_PROCESS_METRICS=true
PROMETHEUS_INCLUDE_PLATFORM_METRICS=true

# Local-development-only defaults. Set a strong GRAFANA_ADMIN_PASSWORD
# (and restrict network access to both services) before any non-local use.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3001

PROMETHEUS_PORT=9090
PROMETHEUS_SCRAPE_INTERVAL_SECONDS=15
PROMETHEUS_RETENTION_TIME=15d
EVAL_DASHBOARD_ADMIN_EMAILS=
EVAL_ONLINE_RUBRIC_JUDGE_ENABLED=false
MEMORY_ONLINE_UTILITY_JUDGE_ENABLED=false
EVAL_ONLINE_BASELINE_SAMPLE_RATE=0.075

MEMORY_LIFECYCLE_ENABLED=true
MEMORY_LIFECYCLE_DRY_RUN=true
MEMORY_LIFECYCLE_INTERVAL_SECONDS=86400
MEMORY_LIFECYCLE_LOCK_TTL_SECONDS=1800
MEMORY_LIFECYCLE_BATCH_SIZE=500

MEMORY_LIFECYCLE_USER_STALE_AFTER_DAYS=365
MEMORY_LIFECYCLE_USER_MAX_IMPORTANCE=0.1

MEMORY_LIFECYCLE_SEMANTIC_STALE_AFTER_DAYS=90
MEMORY_LIFECYCLE_SEMANTIC_MAX_IMPORTANCE=0.3

MEMORY_LIFECYCLE_RESEARCH_STALE_AFTER_DAYS=180
MEMORY_LIFECYCLE_RESEARCH_MAX_IMPORTANCE=0.2
MEMORY_CONSOLIDATION_ENABLED=false
MEMORY_CONSOLIDATION_DRY_RUN=true
MEMORY_CONSOLIDATION_BATCH_SIZE=50
MEMORY_CONSOLIDATION_CANDIDATE_LIMIT=5
MEMORY_CONSOLIDATION_SIMILARITY_THRESHOLD=0.88
MEMORY_PREFERENCE_CANDIDATE_LIMIT=20
MEMORY_PREFERENCE_RECENT_FALLBACK_LIMIT=5
MEMORY_PREFERENCE_TYPED_CONFIDENCE_THRESHOLD=0.85

MEMORY_ONLINE_UTILITY_JUDGE_ENABLED=true
