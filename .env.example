APP_NAME=ResearchMind AI
ENVIRONMENT=development
DEBUG=false

DATABASE_URL=

VALKEY_URL=

QDRANT_URL=

SECRET_KEY=

ACCESS_TOKEN_EXPIRE_MINUTES=30

LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT="ResearchMind"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

AWS_REGION=

COGNITO_USER_POOL_ID=

COGNITO_APP_CLIENT_ID=

COGNITO_DOMAIN=

COGNITO_CLIENT_SECRET=

#######################################
# AI Core
#######################################

AI_AWS_REGION=us-east-1
AWS_S3_BUCKET=researchmind-ai-documents-dev

AWS_ACCESS_KEY_ID=

AWS_SECRET_ACCESS_KEY=

AWS_SESSION_TOKEN=

AWS_S3_ENDPOINT_URL=

QUEUE_NAME=document-processing
QUEUE_MAX_ATTEMPTS=3
QS_QUEUE_URL=
QUEUE_PROVIDER=valkey

VOYAGE_API_KEY=
OPENAI_API_KEY=
SEMANTIC_CACHE_EMBEDDING_PROVIDER=voyage_ai
SEMANTIC_CACHE_EMBEDDING_MODEL=voyage-3-lite
QDRANT_COLLECTION_NAME=researchmind_knowledge
SPARSE_EMBEDDING_MODEL=prithivida/Splade_PP_en_v1

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

OLLAMA_HOST=http://localhost:11434

OPENAI_MODEL=gpt-5.5
CLAUDE_MODEL=claude-sonnet-5
GEMINI_MODEL=gemini-2.5-pro
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_MODEL=qwen3:latest

#######################################
# Web Search Tool (Research Runtime)
#######################################

# Web search stays inert (WEB_SEARCH_ENABLED=false, or no key here) without
# breaking Deep Research -- see web_search_tool_platform_prd.md.
TAVILY_API_KEY=
WEB_SEARCH_ENABLED=true

#######################################
# Research Intelligence MCP (paper search, Chat + Deep Research)
#######################################

# Paper search stays inert (MCP_PAPERS_ENABLED=false, or no server URL here)
# without breaking Chat or Deep Research -- see prds/3. mcp_server_setup.md.
MCP_PAPERS_ENABLED=true
MCP_PAPERS_SERVER_URL=http://127.0.0.1:8080/mcp
MCP_PAPERS_AUTH_TOKEN=

#######################################
# Prometheus / Grafana Observability
#######################################

# PROMETHEUS_ENABLED=false is the rollback flag -- every metrics call site
# degrades to a NoOp recorder and /metrics is not mounted at all, so the
# rest of the app is unaffected. See prds/prometheus_grafana_observability_prd.md.
PROMETHEUS_ENABLED=true
PROMETHEUS_METRICS_PATH=/metrics
PROMETHEUS_INCLUDE_HTTP_METRICS=true
PROMETHEUS_INCLUDE_RUNTIME_METRICS=true
PROMETHEUS_INCLUDE_PROCESS_METRICS=true
PROMETHEUS_INCLUDE_PLATFORM_METRICS=true

# Local-development-only defaults. Set a strong GRAFANA_ADMIN_PASSWORD
# (and restrict network access to both services) before any non-local use.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_PORT=3001

PROMETHEUS_PORT=9090
PROMETHEUS_SCRAPE_INTERVAL_SECONDS=15
PROMETHEUS_RETENTION_TIME=15d
