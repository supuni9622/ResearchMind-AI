AWS_ACCESS_KEY_ID=

AWS_SECRET_ACCESS_KEY=

AWS_SESSION_TOKEN=

AWS_S3_ENDPOINT_URL=

QUEUE_NAME=document-processing
QUEUE_MAX_ATTEMPTS=3
QS_QUEUE_URL=
