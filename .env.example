CLAUDE_MODEL=claude-sonnet-5
GEMINI_MODEL=gemini-2.5-pro
GROQ_MODEL=llama-3.3-70b-versatile
OLLAMA_MODEL=qwen3:latest

#######################################
# Web Search Tool (Research Runtime)
#######################################

# Web search stays inert (WEB_SEARCH_ENABLED=false, or no key here) without
# breaking Deep Research -- see web_search_tool_platform_prd.md.
TAVILY_API_KEY=
WEB_SEARCH_ENABLED=true

#######################################
# Research Intelligence MCP (paper search, Chat + Deep Research)
#######################################

# Paper search stays inert (MCP_PAPERS_ENABLED=false, or no server URL here)
# without breaking Chat or Deep Research -- see prds/3. mcp_server_setup.md.
MCP_PAPERS_ENABLED=true
MCP_PAPERS_SERVER_URL=http://127.0.0.1:8080/mcp
MCP_PAPERS_AUTH_TOKEN=
