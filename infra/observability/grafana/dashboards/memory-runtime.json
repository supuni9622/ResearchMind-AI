    {
      "id": 14,
      "type": "timeseries",
      "title": "Created, updated, superseded",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 48 },
      "fieldConfig": { "defaults": { "unit": "ops" }, "overrides": [] },
      "targets": [
        { "expr": "sum(rate(researchmind_memory_created_total[15m]))", "legendFormat": "created", "refId": "A" },
