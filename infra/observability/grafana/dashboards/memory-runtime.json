      "type": "timeseries",
      "title": "Postgres rows by type and scope",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 56 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        { "expr": "researchmind_memory_storage_rows", "legendFormat": "{{type}} / {{scope}}", "refId": "A" }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Postgres table and index bytes",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 56 },
      "fieldConfig": { "defaults": { "unit": "bytes", "min": 0 }, "overrides": [] },
      "targets": [
        { "expr": "researchmind_memory_storage_bytes", "legendFormat": "{{kind}}", "refId": "A" }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Qdrant points and index drift",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 64 },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0 }, "overrides": [] },
      "targets": [
        { "expr": "researchmind_memory_vector_points", "legendFormat": "Qdrant points", "refId": "A" },
        { "expr": "researchmind_memory_vector_drift", "legendFormat": "{{kind}}", "refId": "B" }
      ]
    },
