        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(researchmind_memory_context_durable_available_total[15m])) * 60",
          "refId": "A",
          "legendFormat": "available"
        },
        {
          "expr": "sum(rate(researchmind_memory_context_durable_empty_total[15m])) * 60",
          "refId": "B",
          "legendFormat": "empty"
        }
      ]
    },
