{
  "id": null,
  "uid": "researchmind-memory-runtime",
  "title": "Memory Runtime",
  "tags": [
    "researchmind",
    "memory"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Memory-context request rate",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(researchmind_memory_context_requests_total[5m])) * 60",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Durable retrieval skip rate",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(researchmind_memory_context_retrieval_skipped_total[15m])) / clamp_min(sum(rate(researchmind_memory_context_requests_total[15m])), 1)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Durable memory available vs empty",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(researchmind_memory_context_durable_available_total[15m])) * 60",
          "refId": "A",
          "legendFormat": "available"
        },
        {
          "expr": "sum(rate(researchmind_memory_context_durable_empty_total[15m])) * 60",
          "refId": "B",
          "legendFormat": "empty"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Semantic/research search rate",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "sum(rate(researchmind_memory_semantic_search_total[5m])) * 60",
          "refId": "A",
          "legendFormat": "semantic"
        },
        {
          "expr": "sum(rate(researchmind_memory_research_search_total[5m])) * 60",
          "refId": "B",
          "legendFormat": "research"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Memory-context P95 latency",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(researchmind_memory_context_duration_seconds_bucket[5m])))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Durable-search P95 latency",
      "gridPos": {
        "h": 8,
